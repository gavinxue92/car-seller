<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.carseller</groupId>
    <artifactId>car-seller</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>cart-service</artifactId>
  <dependencies>
    <!-- 公共模块：统一响应 R、状态码 ResultCode、业务异常与全局异常处理器（版本由根 pom 统一声明） -->
    <dependency>
      <groupId>com.carseller</groupId>
      <artifactId>car-seller-common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>com.alibaba.cloud</groupId>
      <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
    </dependency>
    <!-- 购物车数据以 Redis 为准（Hash：cart:{userId}），Phase 2 不接入数据源 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- @Valid 校验依赖（common 中为 provided，不向下传递，业务服务需自行引入） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- OpenFeign：按服务名调用 product-service 校验商品存在性并获取最新价格 -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-openfeign</artifactId>
    </dependency>
    <!-- Feign 的 lb:// 负载均衡实现（openfeign starter 中为 optional，必须显式引入） -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-loadbalancer</artifactId>
    </dependency>
    <!-- 单元测试：JUnit 5 + Mockito + AssertJ（版本由 spring-boot-dependencies 统一管理） -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>
</project>